{
  "name": "familie-klage-frontend",
  "version": "0.0.1",
  "main": "dist_backend/server.js",
  "repository": "https://github.com/navikt/familie-klage-frontend.git",
  "author": "Nav - teamfamilie",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production ENV=production node dist_backend/server.js",
    "start:dev": "yarn build:backend && NODE_ENV=development node dist_backend/server.js",
    "test": "vitest",
    "build": "yarn validate && yarn build:prod",
    "build:prod": "NODE_ENV=production yarn build:backend && yarn build:frontend",
    "build:backend": "tsc -p src/backend/tsconfig.json",
    "build:frontend": "vite build src/frontend",
    "lint": "eslint './src/**/*.{js,ts,tsx}'",
    "lint:fix": "eslint './src/**/*.{js,ts,tsx}' --fix",
    "prettier": "prettier --check './src/**/*.{js,jsx,ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "validate": "yarn typecheck && yarn lint && yarn prettier",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=150"
    ]
  },
  "dependencies": {
    "@nais/apm": "0.6.0",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/familie-backend": "10.1.24",
    "@navikt/familie-logging": "7.0.7",
    "@navikt/land-verktoy": "14.0.2",
    "axios": "1.19.0",
    "constate": "4.0.0",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-static-gzip": "3.0.1",
    "http-proxy-middleware": "4.2.0",
    "lodash": "4.18.1",
    "prom-client": "15.1.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.86.0",
    "react-pdf": "10.5.0",
    "react-router-dom": "7.18.2",
    "tslib": "2.8.1",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@types/uuid": "11.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "postcss": "8.5.15",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
