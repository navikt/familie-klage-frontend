{
    "name": "familie-klage-frontend",
    "version": "0.0.1",
    "packageManager": "pnpm@11.15.0",
    "main": "dist_backend/server.js",
    "repository": "https://github.com/navikt/familie-klage-frontend.git",
    "author": "Nav - teamfamilie",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "pnpm start:backend:prod",
        "start:dev": "pnpm start:lokalt-mot-preprod",
        "start-env": "pnpm miljøvariabler && pnpm build:backend && ENV=\"$ENV\" pnpm start:backend:dev",
        "start:lokal": "ENV=local pnpm start-env",
        "start:lokalt-mot-preprod": "ENV=lokalt-mot-preprod pnpm start-env",
        "start:backend:dev": "NODE_ENV=development node dist_backend/server.js",
        "start:backend:prod": "NODE_ENV=production ENV=production node dist_backend/server.js",
        "miljøvariabler": "./hent-og-lagre-miljøvariabler.sh",
        "test": "pnpm test:backend && pnpm test:frontend",
        "test:backend": "vitest --config src/backend/vitest.config.ts --run",
        "test:frontend": "vitest --config src/frontend/vitest.config.ts --run",
        "build": "pnpm build:prod",
        "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend",
        "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
        "build:frontend": "vite build src/frontend",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
        "validate": "pnpm typecheck && pnpm check",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,css}": [
            "biome check ."
        ]
    },
    "dependencies": {
        "@nais/apm": "0.7.3",
        "@navikt/ds-css": "8.18.0",
        "@navikt/ds-react": "8.18.0",
        "@navikt/familie-backend": "11.0.1",
        "@navikt/familie-logging": "7.0.11",
        "@navikt/land-verktoy": "15.1.15",
        "axios": "1.20.0",
        "constate": "4.0.0",
        "date-fns": "4.4.0",
        "dotenv": "18.0.5",
        "express": "5.2.1",
        "express-static-gzip": "3.0.2",
        "http-proxy-middleware": "4.2.0",
        "lodash": "4.18.1",
        "prom-client": "15.1.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.89.0",
        "react-pdf": "11.0.0",
        "react-router-dom": "7.18.4",
        "tslib": "2.8.1",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/express": "5.0.6",
        "@types/node": "24.19.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/uuid": "11.0.0",
        "@vercel/nft": "1.11.0",
        "@vitejs/plugin-react": "6.1.1",
        "autoprefixer": "10.6.1",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "lint-staged": "17.6.0",
        "postcss": "8.5.28",
        "typescript": "7.0.2",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    }
}
