{
    "name": "familie-klage-frontend",
    "version": "0.0.1",
    "packageManager": "pnpm@11.15.0",
    "main": "dist_backend/server.js",
    "repository": "https://github.com/navikt/familie-klage-frontend.git",
    "author": "Nav - teamfamilie",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production ENV=production node dist_backend/server.js",
        "start:dev": "pnpm build:backend && NODE_ENV=development node dist_backend/server.js",
        "test": "pnpm test:backend && pnpm test:frontend",
        "test:backend": "vitest --config src/backend/vitest.config.ts --run",
        "test:frontend": "vitest --config src/frontend/vitest.config.ts --run",
        "build": "pnpm build:prod",
        "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend",
        "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
        "build:frontend": "vite build src/frontend",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
        "validate": "pnpm typecheck && biome check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "biome check"
        ]
    },
    "dependencies": {
        "@nais/apm": "0.6.0",
        "@navikt/ds-css": "8.16.1",
        "@navikt/ds-react": "8.16.1",
        "@navikt/familie-backend": "10.1.27",
        "@navikt/familie-logging": "7.0.8",
        "@navikt/land-verktoy": "15.1.7",
        "axios": "1.19.0",
        "constate": "4.0.0",
        "date-fns": "4.4.0",
        "dotenv": "17.4.2",
        "express": "5.2.1",
        "express-static-gzip": "3.0.1",
        "http-proxy-middleware": "4.2.0",
        "lodash": "4.18.1",
        "prom-client": "15.1.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.86.0",
        "react-pdf": "10.5.0",
        "react-router-dom": "7.18.2",
        "tslib": "2.8.1",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@types/express": "5.0.6",
        "@types/node": "24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@types/uuid": "11.0.0",
        "@vercel/nft": "1.10.2",
        "@vitejs/plugin-react": "6.1.0",
        "autoprefixer": "10.5.4",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "postcss": "8.5.26",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    }
}
